import os
from datetime import datetime
from pathlib import Path

from flask import Flask, redirect, render_template, request, session, url_for
from mysql.connector import Error, connect
from werkzeug.security import check_password_hash, generate_password_hash

app = Flask(__name__)
app.secret_key = os.environ.get("SECRET_KEY", "old-age-medication-management-secret")

DB_CONFIG = {
    "host": os.environ.get("DB_HOST", "localhost"),
    "port": int(os.environ.get("DB_PORT", "3306")),
    "user": os.environ.get("DB_USER", "medadmin"),
    "password": os.environ.get("DB_PASSWORD", "MedPass123"),
    "database": os.environ.get("DB_NAME", "medication_system"),
    "autocommit": True,
}


def create_connection():
    try:
        return connect(**DB_CONFIG)
    except Error:
        return None


def initialize_database():
    connection = connect(
        host=DB_CONFIG["host"],
        port=DB_CONFIG["port"],
        user=DB_CONFIG["user"],
        password=DB_CONFIG["password"],
        autocommit=True,
    )
    if connection is None:
        return False

    cursor = connection.cursor()
    cursor.execute("CREATE DATABASE IF NOT EXISTS medication_system")
    cursor.execute("USE medication_system")

    schema_path = Path("schema.sql")
    if schema_path.exists():
        schema_sql = schema_path.read_text(encoding="utf-8")
        try:
            cursor.execute(schema_sql, multi=True)
        except Exception:
            # Fallback for environments that do not support multi=True in the same way.
            for statement in [s.strip() for s in schema_sql.split(";") if s.strip()]:
                cursor.execute(statement)

    cursor.execute("SELECT COUNT(*) FROM users")
    if cursor.fetchone()[0] == 0:
        cursor.execute(
            "INSERT INTO users (username, password_hash, role) VALUES (%s, %s, %s)",
            ("admin", generate_password_hash("admin123"), "admin"),
        )
        cursor.execute(
            "INSERT INTO users (username, password_hash, role) VALUES (%s, %s, %s)",
            ("caretaker", generate_password_hash("caretaker123"), "caretaker"),
        )

    cursor.execute("SELECT COUNT(*) FROM residents")
    if cursor.fetchone()[0] == 0:
        sample_sql = Path("sample_data.sql").read_text(encoding="utf-8")
        for statement in [s.strip() for s in sample_sql.split(";") if s.strip()]:
            if "INSERT INTO" in statement.upper():
                cursor.execute(statement)

    connection.close()
    return True


def get_dashboard_data():
    connection = create_connection()
    if connection is None:
        return {
            "resident_count": 5,
            "medicine_count": 8,
            "upcoming_doses": 7,
            "completed_doses": 12,
            "alerts": [
                {"type": "Low stock", "message": "Paracetamol only 6 tablets left"},
                {"type": "Expiry", "message": "Amoxicillin expires in 5 days"},
            ],
            "residents": [
                {"name": "Margaret Smith", "room": "A-12", "age": 82, "condition": "Arthritis"},
                {"name": "John Peters", "room": "B-04", "age": 76, "condition": "Diabetes"},
                {"name": "Rose Wilson", "room": "C-07", "age": 88, "condition": "Hypertension"},
            ],
            "medicines": [
                {"name": "Paracetamol", "dosage": "500mg", "stock": 6, "expiry": "2026-12-02"},
                {"name": "Atorvastatin", "dosage": "10mg", "stock": 42, "expiry": "2026-11-28"},
            ],
            "schedule": [
                {"resident": "Margaret Smith", "medicine": "Paracetamol", "time": "08:00"},
                {"resident": "John Peters", "medicine": "Insulin", "time": "09:30"},
            ],
        }

    try:
        cursor = connection.cursor(dictionary=True)
        cursor.execute("SELECT COUNT(*) AS total FROM residents")
        resident_count = cursor.fetchone()["total"]

        cursor.execute("SELECT COUNT(*) AS total FROM medicines")
        medicine_count = cursor.fetchone()["total"]

        cursor.execute("SELECT COUNT(*) AS total FROM medication_log WHERE status='completed'")
        completed_doses = cursor.fetchone()["total"]

        cursor.execute("SELECT COUNT(*) AS total FROM medication_schedule WHERE status='upcoming'")
        upcoming_doses = cursor.fetchone()["total"]

        cursor.execute("SELECT * FROM residents ORDER BY id DESC LIMIT 8")
        residents = cursor.fetchall()

        cursor.execute("SELECT * FROM medicines ORDER BY expiry_date ASC LIMIT 8")
        medicines = cursor.fetchall()

        cursor.execute("SELECT ms.id, r.name AS resident_name, m.name AS medicine_name, ms.dosage_time FROM medication_schedule ms JOIN residents r ON r.id = ms.resident_id JOIN medicines m ON m.id = ms.medicine_id ORDER BY ms.dosage_time LIMIT 10")
        schedule = cursor.fetchall()

        cursor.execute("SELECT * FROM stock_alerts ORDER BY created_at DESC LIMIT 5")
        alerts = cursor.fetchall()

        connection.close()
        return {
            "resident_count": resident_count,
            "medicine_count": medicine_count,
            "upcoming_doses": upcoming_doses,
            "completed_doses": completed_doses,
            "alerts": alerts,
            "residents": residents,
            "medicines": medicines,
            "schedule": schedule,
        }
    except Error:
        connection.close()
        return get_dashboard_data()


@app.route("/")
def index():
    user = session.get("user")
    dashboard = get_dashboard_data()
    return render_template("index.html", user=user, dashboard=dashboard)


@app.route("/login", methods=["POST"])
def login():
    username = request.form.get("username", "").strip()
    password = request.form.get("password", "")

    connection = create_connection()
    if not connection:
        return redirect(url_for("index"))

    try:
        cursor = connection.cursor(dictionary=True)
        cursor.execute("SELECT * FROM users WHERE username = %s", (username,))
        user = cursor.fetchone()
        if user and check_password_hash(user["password_hash"], password):
            session["user"] = user["username"]
            session["role"] = user["role"]
            return redirect(url_for("index"))
    except Error:
        pass
    finally:
        connection.close()

    return redirect(url_for("index"))


@app.route("/logout")
def logout():
    session.clear()
    return redirect(url_for("index"))


if __name__ == "__main__":
    try:
        initialize_database()
    except Exception:
        pass
    app.run(debug=True, host="0.0.0.0", port=5000)
