<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Old Age Home Medication System</title>
    <style>
        :root {
            --primary: #3e7c68;
            --primary-dark: #255846;
            --accent: #f5b942;
            --bg: #edf5f1;
            --panel: #ffffff;
            --text: #1d2b2a;
            --muted: #6d7d7a;
            --danger: #d65b5b;
            --success: #34a853;
            --shadow: 0 12px 28px rgba(31, 52, 48, 0.12);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(135deg, #ebf8f4, #f7f7f3);
            color: var(--text);
        }

        a { text-decoration: none; color: inherit; }

        .auth-shell {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            background: linear-gradient(135deg, #eaf7f2 0%, #f5faef 100%);
        }

        .auth-box {
            width: min(1100px, 100%);
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 24px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .intro {
            background: linear-gradient(135deg, #345d4d, #487d6e);
            color: white;
            padding: 52px 36px;
        }

        .intro h1 {
            margin: 0 0 14px;
            font-size: clamp(2rem, 3vw, 3rem);
        }

        .intro p {
            line-height: 1.6;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 28px;
        }

        .feature-list {
            display: grid;
            gap: 14px;
            margin-top: 24px;
        }

        .feature-item {
            background: rgba(255,255,255,0.08);
            padding: 14px 16px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.12);
            font-weight: 600;
        }

        .login-panel {
            padding: 42px 32px;
            background: var(--panel);
        }

        .login-panel h2 {
            margin: 0 0 12px;
            font-size: 2rem;
            color: var(--text);
        }

        .login-panel p {
            margin: 0 0 20px;
            color: var(--muted);
        }

        form {
            display: grid;
            gap: 16px;
        }

        .form-field {
            display: grid;
            gap: 8px;
        }

        label {
            font-weight: 700;
            color: var(--text);
            font-size: 0.95rem;
        }

        input, select, button {
            border-radius: 12px;
            font-size: 1rem;
        }

        input, select {
            padding: 14px 14px;
            border: 1px solid #d6dfe3;
            background: #f9fbfb;
            color: var(--text);
        }

        .primary-btn {
            border: none;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            font-weight: 700;
            padding: 14px 20px;
            cursor: pointer;
            box-shadow: 0 8px 18px rgba(62, 124, 104, 0.25);
        }

        .secondary-btn {
            background: var(--accent);
            color: #1d2b2a;
            border: none;
            padding: 10px 16px;
            font-weight: 700;
            cursor: pointer;
        }

        .dashboard-shell {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--panel);
            padding: 18px 24px;
            border-radius: 18px;
            box-shadow: var(--shadow);
            margin-bottom: 22px;
        }

        .brand {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--primary-dark);
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .profile-badge {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            display: grid;
            place-items: center;
            font-weight: 700;
        }

        .layout {
            display: grid;
            grid-template-columns: 240px 1fr;
            gap: 20px;
        }

        .sidebar {
            background: var(--panel);
            border-radius: 18px;
            box-shadow: var(--shadow);
            padding: 20px 16px;
            min-height: 600px;
        }

        .nav-section {
            display: grid;
            gap: 10px;
        }

        .nav-item {
            background: #eef6f2;
            border: none;
            padding: 12px 14px;
            border-radius: 10px;
            text-align: left;
            font-weight: 700;
            color: var(--text);
            cursor: pointer;
        }

        .nav-item.active {
            background: var(--primary);
            color: white;
        }

        .content {
            display: grid;
            gap: 20px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
        }

        .stat-card {
            background: var(--panel);
            border-radius: 18px;
            box-shadow: var(--shadow);
            padding: 18px 20px;
        }

        .stat-label {
            color: var(--muted);
            font-weight: 700;
            margin-bottom: 10px;
        }

        .stat-value {
            font-size: clamp(1.8rem, 2vw, 2.6rem);
            font-weight: 800;
            color: var(--primary-dark);
        }

        .stat-trend {
            margin-top: 12px;
            color: var(--success);
            font-size: 0.85rem;
            font-weight: 700;
        }

        .panel-grid {
            display: grid;
            grid-template-columns: 1.3fr 1fr;
            gap: 20px;
        }

        .panel {
            background: var(--panel);
            border-radius: 18px;
            box-shadow: var(--shadow);
            padding: 18px 20px;
        }

        .section-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .section-head h3 {
            margin: 0;
            font-size: 1.3rem;
        }

        .resident-form {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 18px;
        }

        .full-span {
            grid-column: 1 / -1;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            font-size: 0.95rem;
        }

        th, td {
            padding: 12px 10px;
            border-bottom: 1px solid #e9f0ef;
            text-align: left;
        }

        th {
            background: #f3f9f7;
            color: var(--primary-dark);
        }

        .tag {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .tag.good {
            background: rgba(52, 168, 83, 0.12);
            color: var(--success);
        }

        .tag.warning {
            background: rgba(245, 185, 66, 0.15);
            color: #b57000;
        }

        .tag.danger {
            background: rgba(214, 91, 91, 0.12);
            color: var(--danger);
        }

        .alert-list {
            display: grid;
            gap: 10px;
        }

        .alert-item {
            border-left: 5px solid var(--danger);
            padding: 12px 12px;
            border-radius: 10px;
            background: #fff8f8;
            color: var(--text);
        }

        .report-box {
            border: 1px dashed #b9d8ce;
            background: #f6fbf9;
            border-radius: 12px;
            padding: 16px;
            margin-top: 10px;
            color: var(--muted);
            line-height: 1.6;
        }

        .secondary-btn.small {
            padding: 8px 12px;
            font-size: 0.88rem;
        }

        @media (max-width: 900px) {
            .auth-box, .panel-grid, .layout {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .resident-form {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 560px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .topbar {
                flex-direction: column;
                gap: 12px;
                align-items: flex-start;
            }
        }
    </style>
</head>
<body>
    {% if not user %}
        <div class="auth-shell">
            <div class="auth-box">
                <div class="intro">
                    <h1>Medication Care Dashboard</h1>
                    <p>Simple and secure medicine tracking for old age home caretakers. Manage residents, maintain records, monitor scheduled doses, and ensure stock safety with confidence.</p>
                    <div class="feature-list">
                        <div class="feature-item">Resident Records & Medical History</div>
                        <div class="feature-item">Medication Schedules & Alerts</div>
                        <div class="feature-item">Medicine Stock Monitoring</div>
                        <div class="feature-item">Daily Reports & Safety Checks</div>
                    </div>
                </div>
                <div class="login-panel">
                    <h2>Login</h2>
                    <p>Use your administrator or caretaker account to continue.</p>
                    <form method="POST" action="{{ url_for('login') }}">
                        <div class="form-field">
                            <label for="username">Username</label>
                            <input id="username" name="username" type="text" placeholder="Enter username" required>
                        </div>
                        <div class="form-field">
                            <label for="password">Password</label>
                            <input id="password" name="password" type="password" placeholder="Enter password" required>
                        </div>
                        <button type="submit" class="primary-btn">Sign In</button>
                    </form>
                    <div class="report-box" style="margin-top: 20px;">
                        Default credentials:<br>
                        Admin: admin / admin123<br>
                        Caretaker: caretaker / caretaker123
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="dashboard-shell">
            <header class="topbar">
                <div class="brand">Old Age Home Medication System</div>
                <div class="profile">
                    <div class="profile-badge">{{ user[0]|upper }}</div>
                    <div>
                        <strong>{{ user|title }}</strong><br>
                        <small>{{ session.get('role', 'caretaker')|title }}</small>
                    </div>
                    <a href="{{ url_for('logout') }}" class="secondary-btn small">Logout</a>
                </div>
            </header>

            <div class="layout">
                <aside class="sidebar">
                    <div class="nav-section">
                        <button class="nav-item active">Overview</button>
                        <button class="nav-item">Residents</button>
                        <button class="nav-item">Medicines</button>
                        <button class="nav-item">Reminders</button>
                        <button class="nav-item">Reports</button>
                    </div>
                </aside>

                <main class="content">
                    <section class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-label">Residents</div>
                            <div class="stat-value">{{ dashboard.resident_count }}</div>
                            <div class="stat-trend">+2 this month</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Medicines</div>
                            <div class="stat-value">{{ dashboard.medicine_count }}</div>
                            <div class="stat-trend">Healthy inventory</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Upcoming Doses</div>
                            <div class="stat-value">{{ dashboard.upcoming_doses }}</div>
                            <div class="stat-trend">Today</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Completed Doses</div>
                            <div class="stat-value">{{ dashboard.completed_doses }}</div>
                            <div class="stat-trend">This week</div>
                        </div>
                    </section>

                    <section class="panel-grid">
                        <div class="panel">
                            <div class="section-head">
                                <h3>Resident Management</h3>
                                <button class="secondary-btn small" type="button">Add Resident</button>
                            </div>
                            <form class="resident-form" onsubmit="event.preventDefault(); showMessage('Resident saved successfully.');">
                                <div class="form-field">
                                    <label>Resident Name</label>
                                    <input type="text" value="Margaret Smith" placeholder="Full name">
                                </div>
                                <div class="form-field">
                                    <label>Age</label>
                                    <input type="number" value="82">
                                </div>
                                <div class="form-field">
                                    <label>Room Number</label>
                                    <input type="text" value="A-12">
                                </div>
                                <div class="form-field">
                                    <label>Contact</label>
                                    <input type="text" value="071-555-1101">
                                </div>
                                <div class="form-field full-span">
                                    <label>Medical Conditions</label>
                                    <input type="text" value="Arthritis, Hypertension">
                                </div>
                                <button type="submit" class="primary-btn full-span">Save Resident</button>
                            </form>

                            <table>
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Room</th>
                                        <th>Age</th>
                                        <th>Condition</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for resident in dashboard.residents %}
                                    <tr>
                                        <td>{{ resident.name }}</td>
                                        <td>{{ resident.room_number if resident.room_number else resident.room }}</td>
                                        <td>{{ resident.age }}</td>
                                        <td><span class="tag good">{{ resident.medical_conditions if resident.medical_conditions else resident.condition }}</span></td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <div class="panel">
                            <div class="section-head">
                                <h3>Medicine Stock</h3>
                                <button class="secondary-btn small" type="button">Add Medicine</button>
                            </div>
                            <table>
                                <thead>
                                    <tr>
                                        <th>Medicine</th>
                                        <th>Stock</th>
                                        <th>Expiry</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for medicine in dashboard.medicines %}
                                    <tr>
                                        <td>{{ medicine.name }}</td>
                                        <td>
                                            {% if medicine.stock_quantity is defined %}
                                                {{ medicine.stock_quantity }}
                                            {% else %}
                                                {{ medicine.stock }}
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if medicine.expiry_date is defined %}
                                                {{ medicine.expiry_date }}
                                            {% else %}
                                                {{ medicine.expiry }}
                                            {% endif %}
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <section class="panel-grid">
                        <div class="panel">
                            <div class="section-head">
                                <h3>Upcoming Doses</h3>
                                <button class="secondary-btn small" type="button">View Calendar</button>
                            </div>
                            <table>
                                <thead>
                                    <tr>
                                        <th>Resident</th>
                                        <th>Medicine</th>
                                        <th>Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in dashboard.schedule %}
                                    <tr>
                                        <td>{{ item.resident_name if item.resident_name else item.resident }}</td>
                                        <td>{{ item.medicine_name if item.medicine_name else item.medicine }}</td>
                                        <td>{{ item.dosage_time if item.dosage_time else item.time }}</td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <div class="panel">
                            <div class="section-head">
                                <h3>Important Alerts</h3>
                            </div>
                            <div class="alert-list">
                                {% for item in dashboard.alerts %}
                                <div class="alert-item">
                                    <strong>{{ item.alert_type if item.alert_type else item.type }}</strong><br>
                                    {{ item.details if item.details else item.message }}
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                    </section>

                    <section class="panel">
                        <div class="section-head">
                            <h3>Daily Medication Report</h3>
                            <button class="secondary-btn small" type="button" id="reportButton">Generate Report</button>
                        </div>
                        <div class="report-box" id="reportBox">
                            Daily report ready: 4 residents received full medication checks today. 2 alerts are pending review. Stock levels are stable with one medicine below reorder threshold.
                        </div>
                    </section>
                </main>
            </div>
        </div>
    {% endif %}

    <script>
        function showMessage(message) {
            alert(message);
        }

        const reportButton = document.getElementById('reportButton');
        if (reportButton) {
            reportButton.addEventListener('click', function () {
                const reportText = document.getElementById('reportBox');
                const d = new Date();
                reportText.textContent = 'Medication report generated on ' + d.toLocaleString() + '. Caretaker review is complete. 1 low-stock alert and 1 expiry notice require attention.';
            });
        }
    </script>
</body>
</html>
